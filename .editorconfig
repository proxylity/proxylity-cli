root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,props,csproj,slnx}]
indent_size = 2

[*.cs]
# Static factory members on generic result types are intentional (Resolved<T>.Ok/Fail).
dotnet_diagnostic.CA1000.severity = none
# Enum members such as String/Object/Number mirror JSON and template terminology.
dotnet_diagnostic.CA1720.severity = none
# This is an application, not a library with a localization story.
dotnet_diagnostic.CA1303.severity = none
